{
  "name": "@tetherin/greptile",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "TetherIn Greptile evidence, deterministic impact confirmation, and validation gate",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"../../fixtures/greptile/**/*.json\" \"../../fixtures/greptile/README.md\" \"../../docs/workstreams/person-b/HANDOFF.md\" package.json tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:fixtures": "vitest run test/fixtures"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "prettier": "3.9.6",
    "vitest": "4.1.11"
  }
}
