# Public application configuration
TETHERIN_BASE_URL=http://localhost:3000
TETHERIN_ENV=development
TETHERIN_DEMO_MODE=true

# Persistence and encryption (replace locally; never commit real values)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tetherin
TETHERIN_ENCRYPTION_KEY=

# Least-privilege TetherIn GitHub App
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_WEBHOOK_SECRET=

# Codex migration runner
OPENAI_API_KEY=
CODEX_MODEL=

# Greptile MCP. Use fixture mode until the repo is enabled and KB rollout is confirmed.
GREPTILE_MODE=fixture
GREPTILE_MCP_URL=https://api.greptile.com/mcp
GREPTILE_API_KEY=

# Pinned contract-diff engine
OASDIFF_VERSION=1.29.1
