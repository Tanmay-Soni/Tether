# Local application configuration. Copy to .env.local; never commit real values.
TETHERIN_BASE_URL=http://localhost:3000
TETHERIN_MODE=fixture
TETHERIN_DATABASE_PATH=.tetherin/tetherin.db
TETHERIN_ARTIFACTS_PATH=.tetherin/artifacts
TETHERIN_RUNS_PATH=.tetherin/runs
TETHERIN_RETENTION_DAYS=7

# Dedicated consumer demo checkout. It must not be this Tether repository.
TETHERIN_CONSUMER_REPO_PATH=/absolute/path/to/tetherin-stripe-demo
TETHERIN_CONSUMER_REPO=Tanmay-Soni/tetherin-stripe-demo
TETHERIN_CONSUMER_BASE_BRANCH=main
# Optional fork-head fallback when the authenticated gh account cannot push upstream.
TETHERIN_CONSUMER_PUSH_REMOTE=origin
TETHERIN_CONSUMER_PR_HEAD_OWNER=

# Codex migration runner
# The SDK first reuses the authenticated Codex CLI session. An API key is optional.
OPENAI_API_KEY=
CODEX_MODEL=

# Greptile MCP. Fixture mode is visible and can never satisfy the live-ready gate.
GREPTILE_MODE=fixture
GREPTILE_MCP_URL=https://api.greptile.com/mcp
GREPTILE_API_KEY=

# Pinned contract-diff engine
OASDIFF_VERSION=1.29.1
