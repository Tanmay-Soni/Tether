{
  "name": "@tetherin/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build src/client.tsx --outdir dist/public --target browser && bun build src/server.ts --outdir dist --target bun",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "bun src/server.ts"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/themes": "3.2.1",
    "@tetherin/config": "workspace:*",
    "@tetherin/git-local": "workspace:*",
    "@tetherin/local-state": "workspace:*",
    "@tetherin/orchestrator": "workspace:*",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/bun": "1.3.11",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  }
}
