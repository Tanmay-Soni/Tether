{
  "name": "@tetherin/runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build src/main.ts --outdir ../../dist/runner --target bun",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "bun src/main.ts"
  },
  "dependencies": {
    "@tetherin/codex-runner": "workspace:*",
    "@tetherin/config": "workspace:*",
    "@tetherin/github-cli": "workspace:*",
    "@tetherin/git-local": "workspace:*",
    "@tetherin/greptile": "workspace:*",
    "@tetherin/local-state": "workspace:*",
    "@tetherin/orchestrator": "workspace:*",
    "@tetherin/provider-pipeline": "workspace:*",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@types/bun": "1.3.11",
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
