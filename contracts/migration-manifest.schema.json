{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tetherin.dev/contracts/migration-manifest.schema.json",
  "title": "TetherIn migration manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "manifestId",
    "provider",
    "source",
    "engine",
    "changes",
    "detectedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "tetherin.migration-manifest/v1"
    },
    "manifestId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{7,127}$"
    },
    "provider": {
      "type": "string",
      "enum": ["openai", "stripe", "twilio"]
    },
    "source": {
      "$ref": "#/$defs/specPair"
    },
    "engine": {
      "$ref": "#/$defs/engine"
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/change"
      }
    },
    "providerGuidance": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/guidance"
      },
      "default": []
    },
    "detectedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "specRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "specUrl", "sha256"],
      "properties": {
        "commit": {
          "$ref": "#/$defs/sha1"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "specUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "specPair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repositoryUrl",
        "licenseSpdx",
        "old",
        "new",
        "fetchedAt"
      ],
      "properties": {
        "repositoryUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com/"
        },
        "licenseSpdx": {
          "const": "MIT"
        },
        "old": {
          "$ref": "#/$defs/specRevision"
        },
        "new": {
          "$ref": "#/$defs/specRevision"
        },
        "fetchedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "releaseCommit",
        "releaseUrl",
        "command",
        "outputFormat",
        "rawOutputSha256"
      ],
      "properties": {
        "name": {
          "const": "oasdiff"
        },
        "version": {
          "const": "1.29.1"
        },
        "releaseCommit": {
          "const": "2bb87bada404d350cb56e5504e8bd5d76f6159bf"
        },
        "releaseUrl": {
          "const": "https://github.com/oasdiff/oasdiff/releases/tag/v1.29.1"
        },
        "command": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "string"
          }
        },
        "outputFormat": {
          "const": "json"
        },
        "rawOutputSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "sourceLocation": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["url", "line", "column"],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "endLine": {
          "type": "integer",
          "minimum": 1
        },
        "endColumn": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "endpoint",
            "request-property",
            "response-property",
            "parameter",
            "schema",
            "security",
            "other"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "jsonPointer": {
          "type": "string",
          "pattern": "^/"
        }
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "oasdiffId",
        "fingerprint",
        "severity",
        "breaking",
        "method",
        "path",
        "operationId",
        "text",
        "subject",
        "oldLocation",
        "newLocation",
        "schemaExcerpts"
      ],
      "properties": {
        "oasdiffId": {
          "type": "string",
          "minLength": 1
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]+$"
        },
        "severity": {
          "type": "string",
          "enum": ["error", "warning", "info"]
        },
        "breaking": {
          "type": "boolean"
        },
        "method": {
          "type": "string",
          "pattern": "^[A-Z]+$"
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "operationId": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "$ref": "#/$defs/subject"
        },
        "oldLocation": {
          "$ref": "#/$defs/sourceLocation"
        },
        "newLocation": {
          "$ref": "#/$defs/sourceLocation"
        },
        "schemaExcerpts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["old", "new"],
          "properties": {
            "old": {
              "type": ["object", "array", "string", "number", "boolean", "null"]
            },
            "new": {
              "type": ["object", "array", "string", "number", "boolean", "null"]
            }
          }
        }
      }
    },
    "guidance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "url", "source"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "source": {
          "type": "string",
          "enum": ["provider-repository", "provider-docs", "provider-changelog"]
        },
        "excerpt": {
          "type": "string",
          "maxLength": 1000
        }
      }
    }
  }
}
